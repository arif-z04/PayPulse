# ==========================================
# PayPulse — Comprehensive .gitignore
# ==========================================

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
*.directory

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node & Frontend Build Outputs
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
.eslintcache

# Environment & Local Secrets
*.local
.env.local
.env.*.local

# .NET Build Outputs & NuGet
[Bb]in/
[Oo]bj/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.dbmdl
*.jfm
.nuget/
*.lock.json
project.lock.json

# Test Results & Code Coverage
[Tt]est[Rr]esults/
coverage/
*.trx
*.coverage
*.coveragexml

# IDEs & Code Editors
.vs/
.idea/
*.sublime-workspace
*.sublime-project
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Python Virtual Environments & Bytecode
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
